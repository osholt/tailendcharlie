<!--
  Android Auto declarations, merged into the release build only when it is made
  with `-PandroidAuto=true` (see `includeAndroidAuto` in app/build.gradle.kts;
  the `Android internal testing` workflow's android_auto input sets it). Without
  that switch this manifest is not merged into phone or Play releases, and
  CI asserts the merged manifest is free of every declaration below.

  Keep the implementation and its tests healthy here, but do not move these
  declarations back to src/main until Android Auto distribution is approved.
  Never publish an Android Auto bundle to open testing: its Android for Cars
  review is blocking (docs/open-beta-plan.md, G5).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <application>
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <service
            android:name=".TailEndCharlieCarAppService"
            android:exported="true"
            android:label="Tail End Charlie"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="androidx.car.app.action.NAVIGATE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>
    </application>
</manifest>
