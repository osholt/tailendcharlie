{
  "version": 8,
  "name": "Tail End Charlie observer",
  "metadata": {
    "tec:purpose": "Observer map. Deliberately low-contrast so rider markers dominate.",
    "tec:sources": "Vector tiles proxied by the relay under /maps/basemap and /maps/fonts, so an observer's viewport is never disclosed to a third-party CDN.",
    "tec:templated": "Caddy renders the placeholder calls below per request, so this one file is correct on production, preproduction and localhost. The URLs must come out absolute: MapLibre fetches tiles and glyphs from a worker with no document base, so a relative URL throws 'Failed to parse URL' and draws an empty map with no error at all. Serving this file without the templates directive is therefore a silent breakage - tools/check-observer-basemap.sh checks for it. Note this whole file is a Go template, so any text added here that looks like a template action will fail to parse."
  },
  "glyphs": "{{placeholder `http.request.scheme`}}://{{placeholder `http.request.hostport`}}/maps/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "basemap": {
      "type": "vector",
      "tiles": [
        "{{placeholder `http.request.scheme`}}://{{placeholder `http.request.hostport`}}/maps/basemap/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "<a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noreferrer\">&copy; OpenStreetMap</a> contributors, <a href=\"https://www.openmaptiles.org/\" target=\"_blank\" rel=\"noreferrer\">&copy; OpenMapTiles</a>, <a href=\"https://openfreemap.org\" target=\"_blank\" rel=\"noreferrer\">OpenFreeMap</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#14111b" }
    },
    {
      "id": "landcover-green",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "filter": ["in", "class", "wood", "grass", "scrub", "farmland"],
      "paint": { "fill-color": "#17201c", "fill-opacity": 0.7 }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "basemap",
      "source-layer": "park",
      "paint": { "fill-color": "#17201c", "fill-opacity": 0.6 }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "filter": ["in", "class", "residential", "suburb", "quarter"],
      "paint": { "fill-color": "#181420" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "filter": ["!=", "brunnel", "tunnel"],
      "paint": { "fill-color": "#1b2436" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "basemap",
      "source-layer": "waterway",
      "minzoom": 8,
      "paint": {
        "line-color": "#1b2436",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 2]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "basemap",
      "source-layer": "building",
      "minzoom": 14,
      "paint": { "fill-color": "#201b29", "fill-opacity": 0.8 }
    },
    {
      "id": "boundary-admin",
      "type": "line",
      "source": "basemap",
      "source-layer": "boundary",
      "filter": ["<=", "admin_level", 4],
      "paint": {
        "line-color": "#3a3247",
        "line-width": 0.8,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": ["in", "class", "path", "track"],
      "paint": {
        "line-color": "#241f2e",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.5, 18, 2],
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["in", "class", "minor", "service"],
      "paint": {
        "line-color": "#2a2434",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.5, 18, 6]
      }
    },
    {
      "id": "road-tertiary",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["in", "class", "tertiary", "secondary"],
      "paint": {
        "line-color": "#352e42",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.6, 18, 9]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 7,
      "filter": ["in", "class", "primary", "trunk"],
      "paint": {
        "line-color": "#40374f",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.8, 18, 11]
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": ["==", "class", "motorway"],
      "paint": {
        "line-color": "#4d4260",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.8, 18, 13]
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#8d84a0",
        "text-halo-color": "#14111b",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town", "village", "hamlet"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Bold"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          10,
          14,
          15
        ],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#c4b9c0",
        "text-halo-color": "#14111b",
        "text-halo-width": 1.4
      }
    }
  ]
}
