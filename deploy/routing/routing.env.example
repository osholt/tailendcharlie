# Copy to deploy/routing/.env on the routing host (git-ignored) and fill in.
# Never commit the real file: the repository is public.

# Public hostname. A DNS A record must point at the routing VM before the
# first deploy, or Caddy cannot obtain a certificate.
ROUTING_DOMAIN=routing.example.com

# Where Valhalla tiles, the Photon index and downloads live. Needs about 90 GB
# free at the peak of a rebuild; see docs/routing-service.md.
ROUTING_DATA_DIR=/srv/routing

# Client identification. The app sends X-Client-Id: tailendcharlie.app. The web
# planner is recognised by its Origin; the two production origins are fixed in
# the Caddyfile, and this admits one more (a local planner, for example).
ROUTING_CLIENT_ID=tailendcharlie.app
ROUTING_EXTRA_ORIGIN=https://tailendcharlie.app

# Rate limits, requests per minute. Per address (IPv6 grouped by /64) and for
# the whole service. Riders on one mobile network can share an address.
ROUTING_ROUTE_EVENTS_PER_MINUTE=60
ROUTING_ROUTE_EVENTS_PER_MINUTE_TOTAL=1200
ROUTING_MATCHING_EVENTS_PER_MINUTE=240
ROUTING_MATCHING_EVENTS_PER_MINUTE_TOTAL=3000
ROUTING_GEOCODING_EVENTS_PER_MINUTE=120
ROUTING_GEOCODING_EVENTS_PER_MINUTE_TOTAL=3000
ROUTING_MAX_REQUEST_BYTES=1MB

# Serving sizes for the 2 OCPU / 12 GB Always Free shape. On 4 OCPU / 24 GB
# raise the threads to 4, the Photon heap to 4g and its limit to 6g.
VALHALLA_SERVER_THREADS=2
VALHALLA_MEMORY_LIMIT=3g
PHOTON_HEAP=2g
PHOTON_MEMORY_LIMIT=4g

# Rebuild sizes. A build that exceeds its limit is killed and the refresh
# fails, leaving what is serving untouched. On 4 OCPU / 24 GB use 4, 14g, 6g.
VALHALLA_BUILD_THREADS=2
VALHALLA_BUILD_MEMORY_LIMIT=7g
PHOTON_IMPORT_HEAP=3g
PHOTON_IMPORT_MEMORY_LIMIT=5g

# Longest route Valhalla will plan, in kilometres. Its default is 500, which a
# long day in France exceeds. Larger values cost CPU per request.
VALHALLA_MAX_ROUTE_KM=1500

# Data sources. Geofabrik extracts are merged before the Valhalla build. Photon
# imports GraphHopper's Europe dump, keeping only these countries.
ROUTING_PBF_URLS="https://download.geofabrik.de/europe/great-britain-latest.osm.pbf https://download.geofabrik.de/europe/ireland-and-northern-ireland-latest.osm.pbf https://download.geofabrik.de/europe/isle-of-man-latest.osm.pbf https://download.geofabrik.de/europe/france-latest.osm.pbf"
PHOTON_DUMP_URL=https://download1.graphhopper.com/public/europe/photon-dump-europe-1.0-latest.jsonl.zst
PHOTON_COUNTRY_CODES=GB,IE,IM,FR
PHOTON_LANGUAGES=en,fr
# Countries the smoke tests require in both engines. Keep in step with the two
# settings above.
ROUTING_SMOKE_COUNTRIES=GB,IE,IM,FR
