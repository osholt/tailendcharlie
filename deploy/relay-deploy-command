#!/usr/bin/env bash
#
# Forced command for the CI deploy key. Installed on the relay host as
# /usr/local/bin/relay-deploy, owned by root and not writable by the deploy
# user, and named in ~/.ssh/authorized_keys as:
#
#   command="/usr/local/bin/relay-deploy",restrict ssh-ed25519 AAAA... relay-deploy-ci
#
# `restrict` refuses pty, agent, port and X11 forwarding and ~/.ssh/rc, and
# `command=` means the key cannot run a shell at all: whatever the client asks
# for arrives here as SSH_ORIGINAL_COMMAND and is discarded unless it is one of
# the two words below.
#
# What the key can therefore do, in full: deploy a commit that is already on
# main to pre-production or to production. It cannot read a file, open a shell,
# tunnel, or deploy anything that has not been merged — relay-deploy.sh refuses
# a commit that is not an ancestor of origin/main.
#
# This file stays small on purpose. It is installed once, outside the git
# checkout, so it is not rewritten by a deploy; the deploy logic it calls is
# versioned in the repository where it can be reviewed.

set -euo pipefail

deploy_script="${RELAY_DEPLOY_REPO:-/opt/tailendcharlie}/deploy/relay-deploy.sh"
request="${SSH_ORIGINAL_COMMAND:-}"

if ! [[ "$request" =~ ^(staging|production)([[:space:]]+[0-9a-f]{40})?$ ]]; then
  echo "relay-deploy: refused. This key may only run:" >&2
  echo "  staging|production [40-character commit sha]" >&2
  exit 1
fi

# Bootstrap. The deploy script lives in the checkout, and the checkout only
# moves once the deploy script runs — so the very first deploy after the script
# merges has nothing to exec, and so does any deploy that follows a rollback to
# a commit predating it. Move the checkout far enough for the script to exist,
# then let the script do the real, guarded checkout itself.
#
# This is the one piece of deploy logic that cannot live in the repository,
# because it is what reaches the repository. It is kept to the smallest thing
# that works, and it carries the same ancestor guard the script does: this key
# must not be able to check out something that is not on main.
if ! test -x "$deploy_script"; then
  repo="${RELAY_DEPLOY_REPO:-/opt/tailendcharlie}"
  echo "relay-deploy: $deploy_script is missing; bootstrapping the checkout" >&2
  cd "$repo"
  git fetch --quiet origin
  read -r _target bootstrap_commit <<<"$request"
  bootstrap_commit="${bootstrap_commit:-$(git rev-parse --verify origin/main)}"
  git cat-file -e "$bootstrap_commit^{commit}" 2>/dev/null || {
    echo "relay-deploy: unknown commit $bootstrap_commit" >&2
    exit 1
  }
  git merge-base --is-ancestor "$bootstrap_commit" origin/main || {
    echo "relay-deploy: $bootstrap_commit is not an ancestor of origin/main" >&2
    exit 1
  }
  git checkout --quiet --detach "$bootstrap_commit"
  test -x "$deploy_script" || {
    echo "relay-deploy: $deploy_script still missing at $bootstrap_commit" >&2
    exit 1
  }
fi

# Word splitting is the point: the pattern above has already established that
# the request is one or two safe tokens.
# shellcheck disable=SC2086
exec "$deploy_script" $request
