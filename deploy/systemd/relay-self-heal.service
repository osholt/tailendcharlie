[Unit]
Description=Tail End Charlie relay readiness recovery
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/relay-self-heal
User=root
Group=root
UMask=0027
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RuntimeDirectory=relay-self-heal
RuntimeDirectoryMode=0755
StateDirectory=relay-self-heal
StateDirectoryMode=0755
ReadWritePaths=/run/relay-self-heal /var/lib/relay-self-heal
TimeoutStartSec=7min
