[Unit]
Description=Tail End Charlie relay readiness recovery
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/relay-self-heal
User=root
Group=root
UMask=0027
PrivateTmp=true
# Read-only, not hidden: `up -d` resolves the charging collector's env_file,
# which the runbook keeps in the operator's home. A hidden home made Compose
# drop that optional file and recreate the collector with no credentials.
ProtectHome=read-only
ProtectSystem=full
StateDirectory=relay-self-heal
StateDirectoryMode=0755
ReadWritePaths=/var/lib/relay-self-heal
TimeoutStartSec=7min
